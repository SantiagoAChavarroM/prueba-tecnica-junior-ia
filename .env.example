# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# --- Correo (Gmail API con OAuth) ---
# Remitente autorizado: solo se procesan correos que vengan EXACTAMENTE de esta dirección.
AUTHORIZED_SENDER=reportes@empresa-ejemplo.com
# Credenciales del cliente OAuth (Google Cloud Console > APIs y servicios > Credenciales).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Se obtiene una sola vez ejecutando: python scripts/gmail_auth.py
GMAIL_REFRESH_TOKEN=
# Solo se procesan correos cuyo asunto contenga este texto (identificación del correo relevante)
GMAIL_SUBJECT_FILTER=Reporte operacional
# Filtro adicional de búsqueda de Gmail
GMAIL_EXTRA_QUERY=newer_than:30d

# --- Base de datos ---
# Local (por defecto):  sqlite:///data/local.db
# Supabase (Session pooler, compatible con IPv4/GitHub Actions):
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///data/local.db

# --- IA (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Modelos de respaldo si el principal está saturado (503) o sin cuota (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# --- Varios ---
# Carpeta donde se guardan los adjuntos descargados (historial local)
DOWNLOAD_DIR=data/downloads
LOG_LEVEL=INFO
